local { raw, map } = require('erde.markup')
local Layout = require('src/layout')
local Comment = require('src/components/comment')

local item = rest.request('hn::item', { id = rest.req:path_value('id') }):json()

local id = item.url:match('item%?id=(%d+)')
local href = id && "/hn/post/{id}" || item.url

return <Layout title={item.title}>
  <main class="w-[90%]">
    <div class="flex flex-col items-center border-b pt-5">
      <div class="flex flex-row items-center w-full pb-5">
        <a class="pr-5 text-2xl leading-none" href="/hn">&larr;</a>
        <div>
          <h1 class="text-2xl">
            <a href={href} target="_blank" class="underline">
              {item.title}
            </a>
          </h1>
          <div class="opacity-50 text-xs">
            {item.user}
            {item.time_ago}
          </div>
        </div>
      </div>
      {item.content && <div class="py-4 border-t w-full">
        {raw((item.content:gsub('news%.ycombinator%.com/item%?id=', 'taybart.com/hn/post/')))}
      </div>}
    </div>
    {map(item.comments,(comment) -> <Comment comment={comment} />)}
  </main>
</Layout>
