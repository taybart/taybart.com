local { state, map, raw } = require('erde.markup')

local html = (content) -> (content
  :gsub('<a ', '<a target="_blank" ')
  :gsub('news%.ycombinator%.com&#x2F;item%?id=', 'taybart.com&#x2F;post&#x2F;'))

local function Comment({ comment, level = 0 }) {
  local s = state({ collapse = false, leader_collapse = level == 0 })

  if s.collapse {
    return <div class="flex flex-col pb-1 items-start">
        <button onclick={() -> { s.collapse = false }}>
          [+] <span class="opacity-50 pb-2">{comment.user}&nbsp;</span>
        </button>
      </div>
  }

  local replies = comment.comments || {}
  return <div class="flex flex-col pb-1 items-start max-w-full overflow-x-auto">
      <button onclick={() -> { s.collapse = true }}>[-]</button>
      <div class="flex flex-row pl-2 max-w-screen">
        <div class="min-w-[2px] bg-white mr-3"/>
        <div class="flex flex-col items-start">
          <div>{raw(html(comment.content || ''))}</div>
          <span class="opacity-50 pb-2">{comment.user}&nbsp; {comment.time_ago}</span>
          {#replies > 0 && (s.leader_collapse
            && <button class="underline" onclick={() -> { s.leader_collapse = false }}>
                 more replies ({#replies})
               </button>
            || map(replies, (c) -> <Comment key={c.id} comment={c} level={level + 1}/>))}
        </div>
      </div>
    </div>
}

return Comment
